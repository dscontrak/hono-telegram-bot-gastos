{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-cloudflare-telegram",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "vars": {
    "ALLOWED_CHAT_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gastos-db",
      "database_id": "local-gastos-db",
      "migrations_dir": "src/db/migrations"
    }
  ]
}
